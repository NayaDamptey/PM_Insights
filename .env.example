# Copy to .env and fill in. Never commit .env.
# The values below are placeholders that work with the local mock API only.

# --- MRI Qube PM (Qube v1 and MRIAPIServices) -------------------------------
# Basic auth: base64("ClientID/Database/WebServicesUser/PartnerKey:Password")
MRI_BASE_URL=http://localhost:8000
MRI_CLIENT_ID=mock-client
MRI_DATABASE=mock-db
MRI_WEB_SERVICES_USER=mock-user
MRI_PARTNER_KEY=mock-partner-key
MRI_PASSWORD=change-me

# --- FixFlo v2 ----------------------------------------------------------------
# Live: https://{subdomain}.fixflo.com/api/v2
FIXFLO_BASE_URL=http://localhost:8000/fixflo/api/v2
FIXFLO_API_TOKEN=change-me

# --- MRI Engage CRM -------------------------------------------------------------
ENGAGE_BASE_URL=http://localhost:8000
ENGAGE_API_TOKEN=change-me

# --- Mock API behaviour -------------------------------------------------------
# MOCK_DATA_DIR=data/reference
MOCK_CHAOS=false
MOCK_CHAOS_RATE=0.02
MOCK_RETRY_AFTER_SECONDS=1
# MOCK_CHAOS_SEED=42
MOCK_PRELOAD=true
